# Salin menjadi .env di folder front-end-rn.
# Variabel EXPO_PUBLIC_* terlihat di aplikasi: jangan isi secret backend.

# Alamat root BE, TANPA /api di akhir (kode API menambahkannya sendiri).
# Expo Go / HP fisik: http://192.168.1.10:3000 (ganti dengan IP LAN laptop)
# Android emulator: http://10.0.2.2:3000
# iOS simulator / web pada laptop yang menjalankan BE: http://localhost:3000
# Production: https://api.domainmu.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google Identity Services untuk Expo Web. Login native belum terintegrasi.
# Gunakan OAuth Web Client ID yang sama dengan GOOGLE_CLIENT_ID di BE.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
